<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <!-- Header row: label + refresh -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target Saya"
            android:textSize="11sp"
            android:textColor="#9CA3AF"
            android:textStyle="bold"
            android:layout_centerVertical="true" />
        <TextView
            android:id="@+id/refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8635;"
            android:textSize="16sp"
            android:textColor="#2563EB"
            android:padding="4dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Slot 0 -->
    <LinearLayout
        android:id="@+id/slot0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/t0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#1F2937"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_toStartOf="@+id/t0_pct"
                android:layout_alignParentStart="true"
                android:text="" />
            <TextView
                android:id="@+id/t0_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#2563EB"
                android:layout_alignParentEnd="true"
                android:text="" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/t0_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/t0_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:text="" />
            <TextView
                android:id="@+id/t0_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/divider0"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Slot 1 -->
    <LinearLayout
        android:id="@+id/slot1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/t1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#1F2937"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_toStartOf="@+id/t1_pct"
                android:layout_alignParentStart="true"
                android:text="" />
            <TextView
                android:id="@+id/t1_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#2563EB"
                android:layout_alignParentEnd="true"
                android:text="" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/t1_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/t1_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:text="" />
            <TextView
                android:id="@+id/t1_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/divider1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Slot 2 -->
    <LinearLayout
        android:id="@+id/slot2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/t2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#1F2937"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_toStartOf="@+id/t2_pct"
                android:layout_alignParentStart="true"
                android:text="" />
            <TextView
                android:id="@+id/t2_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#2563EB"
                android:layout_alignParentEnd="true"
                android:text="" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/t2_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/t2_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:text="" />
            <TextView
                android:id="@+id/t2_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Buka LifeSync, lalu pin target"
        android:textSize="12sp"
        android:textColor="#9CA3AF"
        android:visibility="visible" />

</LinearLayout>
