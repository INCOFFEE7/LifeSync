<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_bento">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatToDo"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" HUB"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/bento_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hari Ini"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/bento_refresh_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8635;"
                android:textSize="15sp"
                android:textColor="#2563EB"
                android:padding="2dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bento Grid (2 Columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Bento Tile: Finansial & Quick Action -->
        <LinearLayout
            android:id="@+id/bento_finance_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/widget_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENGELUARAN HARI INI"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/bento_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#EF4444"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/bento_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Masuk Rp 0"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="#10B981"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <!-- Spacer to push button down -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Quick Action Button -->
            <TextView
                android:id="@+id/bento_add_note_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Catat"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/widget_btn_bg" />
        </LinearLayout>

        <!-- Right Bento Tile: Target & Reminder -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <!-- Subcard 1: Top Target -->
            <LinearLayout
                android:id="@+id/bento_target_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/widget_card_bg">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/bento_target_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Nabung"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_toStartOf="@+id/bento_target_pct"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/bento_target_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#2563EB"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/bento_target_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/bento_target_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada target di-pin"
                    android:textSize="9sp"
                    android:textColor="#6B7280"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Subcard 2: Next Reminder -->
            <LinearLayout
                android:id="@+id/bento_reminder_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/widget_card_bg">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/bento_reminder_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengingat"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_toStartOf="@+id/bento_reminder_time"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/bento_reminder_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B5CF6"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/bento_reminder_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada pengingat di-pin"
                    android:textSize="9sp"
                    android:textColor="#6B7280"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
